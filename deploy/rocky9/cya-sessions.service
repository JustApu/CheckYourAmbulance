[Unit]
Description=Check Your Ambulance: close inactive inspection sessions (runtime role)
After=mariadb.service

[Service]
Type=oneshot
User=cya
Group=cya
WorkingDirectory=/srv/cya/current
EnvironmentFile=/etc/check-your-ambulance/runtime.env
TimeoutStartSec=900
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ExecStart=/srv/cya/current/local/venv/bin/python manage.py close_inactive_sessions --limit 200
