[Unit]
Description=Check Your Ambulance: notify overdue problem deadlines (runtime role)
After=mariadb.service

[Service]
# Oneshot: never two passes at once. A failed pass is logged and the next tick runs again.
Type=oneshot
User=cya
Group=cya
WorkingDirectory=/srv/cya/current
EnvironmentFile=/etc/check-your-ambulance/runtime.env
TimeoutStartSec=5min
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ExecStart=/srv/cya/current/local/venv/bin/python manage.py notify_overdue --limit 50
