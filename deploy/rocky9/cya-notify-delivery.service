[Unit]
Description=Check Your Ambulance: deliver queued notification email (runtime role)
After=mariadb.service

[Service]
# Oneshot: a tick that arrives while a pass is still running starts no second pass, so an
# SMTP send is never repeated by an overlapping run. A failed pass is logged and the next
# tick runs again; the start timeout ends a pass stuck on the mail server.
Type=oneshot
User=cya
Group=cya
WorkingDirectory=/srv/cya/current
EnvironmentFile=/etc/check-your-ambulance/runtime.env
TimeoutStartSec=5min
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ExecStart=/srv/cya/current/local/venv/bin/python manage.py deliver_notifications --limit 50
