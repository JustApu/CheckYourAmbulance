{
  "relay_file": "/etc/check-your-ambulance/mail-relay.json",
  "state_file": "/var/lib/cya-monitor/state.json",
  "certificates": ["/etc/letsencrypt/live/__HOSTNAME__/fullchain.pem"],
  "certificate_days": 14,
  "disks": ["/", "/var/lib/mysql"],
  "disk_min_free_percent": 10,
  "stale_after": {"cya-backup-full.service": 93600, "cya-backup-binlog.service": 1200},
  "jobs": [
    "cya-obligations.service",
    "cya-sessions.service",
    "cya-backup-full.service",
    "cya-backup-binlog.service",
    "cya-mail-relay-export.service"
  ],
  "relay_max_age": 7200,
  "database_ping": ["mariadb-admin", "--connect-timeout=5", "ping"],
  "access_log": "/var/log/nginx/access.log",
  "errors_window_seconds": 600,
  "errors_threshold": 20
}
